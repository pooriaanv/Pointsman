<Window x:Class="Pointsman.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pointsman settings"
        Icon="pack://application:,,,/Resources/pointsman.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource CanvasBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>

        <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <CheckBox x:Name="AutoInstallBox" FontSize="13.5"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalContentAlignment="Center">
                    Download and install updates automatically
                </CheckBox>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Margin="21,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    When off, Pointsman tells you about a new version and installs it only when you
                    choose Update. Installing restarts Pointsman, which briefly interrupts routed
                    connections.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Margin="21,8,0,0"
                           Foreground="{StaticResource WarningBrush}">
                    Updates marked critical, such as security fixes, are always installed
                    automatically.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" Margin="0,12,0,10"/>

        <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                    Pointsman <Run x:Name="VersionRun"/>
                </TextBlock>
                <TextBlock x:Name="VersionNote" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    Chooses which network adapter each Windows app uses. Windows sends all traffic
                    out of one default route; Pointsman lets you send each program through
                    Ethernet, Wi-Fi or a VPN of your choosing, with nothing to set up inside the app.
                </TextBlock>

                <TextBlock FontSize="12" Margin="0,10,0,0">
                    <Hyperlink NavigateUri="https://github.com/pooriaanv/Pointsman"
                               RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource AccentBrush}">github.com/pooriaanv/Pointsman</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://github.com/pooriaanv/Pointsman/issues"
                               RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource AccentBrush}">Report a problem</Hyperlink>
                </TextBlock>

                <TextBlock Text="Privacy" FontSize="12.5" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <!-- Every claim here was checked against the code. Keep it true: if Pointsman ever
                     starts sending or storing something new, this text has to change with it. -->
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    Pointsman collects nothing about you and sends nothing anywhere. There is no
                    account, no analytics and no telemetry. Your traffic passes through it on this
                    computer and is not recorded.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    Your rules and settings are saved only on this computer, in a Pointsman folder
                    under AppData. The only connection Pointsman makes on its own is to GitHub, to
                    check for and download updates.
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="16" Margin="0,14,0,0"
                           Foreground="{StaticResource TextTertiaryBrush}">
                    Free software under the GNU GPL v3, with absolutely no warranty. Uses the
                    WinDivert driver by basil00.
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
