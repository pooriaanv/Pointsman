<Window x:Class="Pointsman.App.Views.RoutingRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pointsman — Destination routing rules"
        Width="1100" Height="670" MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Destination routing rules" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}">
                Destination policies override app adapter defaults. Higher priority wins; then more specific destinations.
                An unavailable adapter blocks recognized TCP/UDP flows by default. Optional Windows routes
                affect every app and protocol, but are not a firewall kill switch.
            </TextBlock>
            <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Add rule" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
            <Button Content="Edit selected" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
            <Button Content="Delete selected" Style="{StaticResource SecondaryButton}" Click="Delete_Click"/>
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                      SelectionMode="Single" AutoGenerateColumns="False" Margin="6">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, Mode=OneWay}" Width="46"/>
                    <DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=OneWay}" Width="170"/>
                    <DataGridTextColumn Header="PROCESS" Binding="{Binding Process, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination, Mode=OneWay}" Width="190"/>
                    <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Transport, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="PORTS" Binding="{Binding Ports, Mode=OneWay}" Width="85"/>
                    <DataGridTextColumn Header="ROUTE" Binding="{Binding Route, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="MODE" Binding="{Binding Mode, Mode=OneWay}" Width="135"/>
                    <DataGridTextColumn Header="UNAVAILABLE" Binding="{Binding OnUnavailable, Mode=OneWay}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
